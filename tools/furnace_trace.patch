+// fur2gb: register-write trace of the GB backend (FUR2GB_GB_TRACE=path)
+FILE* fur2gbTrace() {
+  static FILE* f=NULL;
+  static bool init=false;
+  if (!init) {
+    init=true;
+    const char* p=getenv("FUR2GB_GB_TRACE");
+    if (p!=NULL && p[0]!=0) f=fopen(p,"wb");
+  }
+  return f;
+}
